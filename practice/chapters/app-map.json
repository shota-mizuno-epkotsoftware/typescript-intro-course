    { "id": "types.ts", "path": "src/types.ts", "kind": "ts", "x": 0, "y": 4.5, "role": "型の定義。実行時には消える", "ch": [2], "fns": ["Entry", "AppState", "Filter"] },
    { "id": "elements.ts", "path": "src/elements.ts", "kind": "ts", "x": 1, "y": 0, "role": "画面の要素を取得する", "ch": [4], "fns": ["getElements"] },
    { "id": "render.ts", "path": "src/render.ts", "kind": "ts", "x": 1, "y": 1, "role": "状態から画面を作り直す", "ch": [1, 4], "fns": ["render"] },
    { "id": "state.ts", "path": "src/state.ts", "kind": "ts", "x": 1, "y": 2, "role": "状態を新しくする関数", "ch": [1, 4], "fns": ["createInitialState", "addEntry", "removeEntry", "setFilter"] },
    { "id": "validate.ts", "path": "src/validate.ts", "kind": "ts", "x": 1, "y": 3, "role": "入力を確かめて明細を作る", "ch": [3], "fns": ["parseEntryForm", "isValidDate"] },
    { "id": "storage.ts", "path": "src/storage.ts", "kind": "ts", "x": 1, "y": 4, "role": "localStorage への保存と読み込み", "ch": [6], "fns": ["loadEntries", "saveEntries"] },
    { "id": "categories.ts", "path": "src/categories.ts", "kind": "ts", "x": 1, "y": 5, "role": "分類の一覧を取ってきて確かめる", "ch": [6], "fns": ["fetchCategories", "parseCategories"] },
    { "id": "format.ts", "path": "src/format.ts", "kind": "ts", "x": 2, "y": 1, "role": "金額や月を表示用の文字にする", "ch": [2], "fns": ["formatYen", "entryLabel", "formatMonth"] },
    { "id": "summary.ts", "path": "src/summary.ts", "kind": "ts", "x": 2, "y": 2, "role": "絞り込み・並べ替え・集計", "ch": [5], "fns": ["filterEntries", "sortByDate", "totalOf", "totalsByCategory"] },
    { "id": "localStorage", "path": "（ブラウザ）", "kind": "ext", "x": 2, "y": 4, "role": "ブラウザの保存場所（ファイルではない）", "ch": [6] },
    { "id": "categories.json", "path": "public/categories.json", "kind": "json", "x": 2, "y": 5, "role": "分類の一覧（public/ の中）", "ch": [6] }
